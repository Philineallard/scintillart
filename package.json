{
  "name": "scintillart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Scintillart website: immersive collage portal entry and retreats page.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:preview": "tsc -b && vite build --mode preview --base ./ --outDir dist-preview",
    "typecheck": "tsc -b --pretty",
    "portal:layers": "python3 scripts/prepare_portal_layers.py"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
